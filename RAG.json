      "parameters": {
        "jsCode": "const raw = $input.all();\nconst items = [];\n\nfor (const item of raw) {\n  const docs = item.json.data.documents;\n  \n  if (!docs || !Array.isArray(docs)) continue;\n  \n  for (const doc of docs) {\n    const text = doc.content;\n    \n    if (!text || text.trim().length < 20) continue;\n\n    items.push({\n      json: {\n        text: text,\n      }\n    });\n  }\n}\n\nreturn items;"
      },
