    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  // ambil output AI & jawaban ground truth\n  const predicted = (item.json.Ground_Truth || \"\").toLowerCase();\n  const expected = (item.json.output || \"\").toLowerCase();\n\n  // tokenisasi sederhana\n  const predTokens = predicted.split(/\\s+/).filter(Boolean);\n  const expTokens = expected.split(/\\s+/).filter(Boolean);\n\n  // hitung token overlap\n  const overlap = predTokens.filter(token => expTokens.includes(token));\n\n  // hitung precision, recall, f1\n  const precision = overlap.length / (predTokens.length || 1);\n  const recall = overlap.length / (expTokens.length || 1);\n  const f1 = (2 * precision * recall) / (precision + recall || 1);\n\n  return {\n    json: {\n      chatInput: item.json.chatInput,\n      Chatbot_Answer: item.json.output,\n      Ground_Truth: item.json.Ground_Truth,\n      precision: Number(precision.toFixed(2)),\n      recall: Number(recall.toFixed(2)),\n      f1_score: Number(f1.toFixed(2))\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4528,
        -256
